import cv2
import os
import numpy as np
from datetime import datetime
from openpyxl import Workbook, load_workbook

# 👉 CHANGE THIS PATH ONLY
path = r"C:\Users\pradn\OneDrive\Documents\project1\faces"

images = []
labels = []
names = []

# ---- LOAD & TRAIN ----
for i, file in enumerate(os.listdir(path)):
    file_path = os.path.join(path, file)

    if file.lower().endswith(('.jpg', '.png', '.jpeg')):
        img = cv2.imread(file_path)

        if img is None:
            continue

        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

        images.append(gray)
        labels.append(i)
        names.append(os.path.splitext(file)[0])

print("Total images:", len(images))

if len(images) == 0:
    raise Exception("No images found!")

# ---- TRAIN ----
recognizer = cv2.face.LBPHFaceRecognizer_create()
recognizer.train(images, np.array(labels))

print("Training completed!")

# ---- EXCEL SETUP ----
file_name = "attendance.xlsx"

if not os.path.exists(file_name):
    wb = Workbook()
    ws = wb.active
    ws.append(["Name", "Date", "Time"])
    wb.save(file_name)

marked_names = set()

# ---- CAMERA ----
cam = cv2.VideoCapture(0)
face_cascade = cv2.CascadeClassifier('haarcascade_frontalface_default.xml')

while True:
    ret, frame = cam.read()

    if not ret:
        break

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    for (x, y, w, h) in faces:
        face = gray[y:y+h, x:x+w]

        label, confidence = recognizer.predict(face)

        if confidence < 100:
            name = names[label]
            color = (0, 255, 0)
        else:
            name = "Unknown"
            color = (0, 0, 255)

        # ---- SAVE TO EXCEL ----
        if name != "Unknown" and name not in marked_names:
            marked_names.add(name)

            now = datetime.now()
            date = now.strftime("%d-%m-%Y")
            time_now = now.strftime("%H:%M:%S")

            wb = load_workbook(file_name)
            ws = wb.active
            ws.append([name, date, time_now])
            wb.save(file_name)

            print(f"Marked: {name}")

        display_text = name
        if name in marked_names:
            display_text = f"{name} (Marked)"

        cv2.putText(frame, display_text, (x, y-10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, color, 2)

        cv2.rectangle(frame, (x,y), (x+w,y+h), color, 2)

    cv2.imshow("Excel Attendance System", frame)

    key = cv2.waitKey(1)
    if key == 27 or key == ord('q'):
        break

cam.release()
cv2.destroyAllWindows()
