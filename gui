import cv2
import os
import numpy as np
from datetime import datetime
from openpyxl import Workbook, load_workbook
import tkinter as tk
from PIL import Image, ImageTk

# 👉 CHANGE THIS PATH ONLY
path = r"C:\Users\pradn\OneDrive\Documents\project1\faces"

images = []
labels = []
names = []

# ---- LOAD & TRAIN ----
for i, file in enumerate(os.listdir(path)):
    file_path = os.path.join(path, file)

    if file.lower().endswith(('.jpg', '.png', '.jpeg')):
        img = cv2.imread(file_path)

        if img is None:
            continue

        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

        images.append(gray)
        labels.append(i)
        names.append(os.path.splitext(file)[0])

recognizer = cv2.face.LBPHFaceRecognizer_create()
recognizer.train(images, np.array(labels))

print("🎉 Training completed!")

# ---- EXCEL SETUP ----
file_name = "attendance.xlsx"

if not os.path.exists(file_name):
    wb = Workbook()
    ws = wb.active
    ws.append(["Name", "Date", "Time"])
    wb.save(file_name)

marked_names = set()

# ---- GUI ----
window = tk.Tk()
window.title("Smart Attendance System")

video_label = tk.Label(window)
video_label.pack()

cam = None
running = False

face_cascade = cv2.CascadeClassifier('haarcascade_frontalface_default.xml')

# ---- FUNCTIONS ----
def start_camera():
    global cam, running
    cam = cv2.VideoCapture(0)
    running = True
    update_frame()

def stop_camera():
    global running, cam
    running = False
    if cam:
        cam.release()
    video_label.config(image='')

def update_frame():
    global cam, running

    if not running:
        return

    ret, frame = cam.read()
    if not ret:
        return

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(gray, 1.3, 5)

    for (x, y, w, h) in faces:
        face = gray[y:y+h, x:x+w]

        label, confidence = recognizer.predict(face)

        if confidence < 100:
            name = names[label]
            color = (0, 255, 0)
        else:
            name = "Unknown"
            color = (0, 0, 255)

        # ---- ATTENDANCE ----
        if name != "Unknown" and name not in marked_names:
            marked_names.add(name)

            now = datetime.now()
            date = now.strftime("%d-%m-%Y")
            time_now = now.strftime("%H:%M:%S")

            wb = load_workbook(file_name)
            ws = wb.active
            ws.append([name, date, time_now])
            wb.save(file_name)

            print("✅ Marked:", name)

            # SAFE AUTO OPEN EXCEL
            try:
                os.startfile(file_name)
            except Exception as e:
                print("⚠️ Could not open Excel:", e)

        display_text = name
        if name in marked_names:
            display_text = f"{name} (Marked)"

        cv2.putText(frame, display_text, (x, y-10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, color, 2)

        cv2.rectangle(frame, (x,y), (x+w,y+h), color, 2)

    # Show in GUI
    img = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    img = Image.fromarray(img)
    imgtk = ImageTk.PhotoImage(image=img)

    video_label.imgtk = imgtk
    video_label.configure(image=imgtk)

    window.after(10, update_frame)

# ---- BUTTONS ----
start_btn = tk.Button(window, text="Start", command=start_camera, bg="green", fg="white")
start_btn.pack(side="left", padx=10, pady=10)

stop_btn = tk.Button(window, text="Stop", command=stop_camera, bg="red", fg="white")
stop_btn.pack(side="right", padx=10, pady=10)

# ---- RUN ----
window.mainloop()
